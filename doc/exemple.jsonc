// Configuration du document doc/exemple.md (JSON avec commentaires autorisés).
// Ce fichier porte le même nom que le .md (exemple.md ↔ exemple.jsonc) ; un .md sans .jsonc est ignoré.
// Les chemins éventuels (icon, logo, customCss) sont relatifs à ce dossier (doc/). Toute clé omise prend sa valeur par défaut.
// Référence complète de toutes les options : README.md à la racine du projet.
{
  // ---------------------------------------------------------------- Général
  // Nom du fichier HTML généré (sans extension), dans output_html/exemple/. Défaut : "index" => output_html/exemple/index.html
  "htmlName": "index",

  // Titre de l'onglet et du sommaire (null = nom du fichier .md)
  "title": "Exemple de document",
  // Icône de l'onglet (favicon) et logo affiché devant le titre du sommaire : chemin d'une image de doc/ (ex. "media/logo.png"), null = aucune
  "icon": null,
  "language": "fr",

  // MODE DE LA PAGE : "auto" suit le système, "light" reste clair, "dark" reste sombre.
  // Le bouton de la page permet aussi de passer manuellement de Auto à Clair ou Sombre.
  "theme": "auto",

  // true : les images sont incorporées dans le HTML (fichier autonome mais lourd, rien à copier).
  // false : les images utilisées sont copiées dans output_html/exemple/ avec la même arborescence que dans doc/ (HTML léger).
  "embedImages": false,

  // ---------------------------------------------------------------- Numérotation des titres
  // `npm run edit:numbering` applique ce schéma au .md ; `edit:numbering:guess` le déduit du .md ; `edit:numbering:reset` l'enlève.
  // Par niveau (1 = « # »…) : "style" =
  //   ignore  : le niveau n'est jamais modifié ;
  //   none    : pas d'indice, mais le "separator" sert de symbole devant le titre ("▪" => "## ▪ Titre") ;
  //   decimal (1, 2) | alpha (a, b) | ALPHA (A, B) | roman (i, ii) | ROMAN (I, II) : numérotation.
  // "separator" = texte placé après chaque indice (".", " ", "-"…). "cumulative" : true => "2.1." (indices des parents inclus).
  "numbering": {
    "levels": {
      "1": { "style": "ignore" },
      "2": { "style": "decimal", "separator": "." },
      "3": { "style": "decimal", "separator": ".", "cumulative": true },
      "4": { "style": "ignore" },
      "5": { "style": "ignore" },
      "6": { "style": "ignore" }
    }
  },

  // ---------------------------------------------------------------- Table des matières (`npm run edit:toc`)
  // Écrite dans le .md entre <!-- TOC --> et <!-- /TOC --> ; insérée en haut du document la première fois.
  "toc": {
    "range": [1, 2],    // [niveau min, niveau max] listés
    "collapsible": false,     // true : table repliable (HTML / Markdown uniquement)
    "summary": "Table des matières",
    "open": false
    // Options avancées par niveau ("levels" : symbol, indent, bold, italic, size, collapsible) : voir README.md
  },

  // ---------------------------------------------------------------- Export PDF (`npm run build:pdf`, Chrome ou Edge requis)
  // Sauts de page dans le Markdown : une ligne `\newpage` ou <!-- newpage -->.
  // Page sans en-tête ni pied (page de garde…) : <!-- nohf --> en toute première ligne, ou juste après un saut de page.
  "pdf": {
    "name": null,         // nom du fichier dans output_pdf/, sans extension (null = nom du .md)
    "theme": "light",       // "light" ou "dark"
    "format": "A4",        // A3, A4, A5, Letter, Legal, Tabloid
    "landscape": false,
    "zoom": 100,            // en % (10 à 200)
    "margins": { "top": "20mm", "right": "18mm", "bottom": "20mm", "left": "18mm" },      // mm, cm, in, pt ou px
    "pageBreakBefore": [1, 2],   // niveaux de titres qui commencent une nouvelle page ; [] = aucun
    "hideToc": false,      // true : retire du PDF la table des matières du .md
    "keepSectionsTogether": true,  // une section qui tient sur une page n'est jamais coupée
    "keepBlocksTogether": true,    // paragraphes, blocs de code… jamais coupés entre deux pages
    "browser": null,             // chemin d'un chrome.exe / msedge.exe ; null = détection automatique

    // En-tête / pied de page : null pour désactiver. Zones left / center / right, HTML autorisé.
    // Variables : {page} {pages} {title} {date} {h1} … {h6}. Image : <img src="media/logo.png" style="height:8mm">
    "header": { "left": "{title}", "right": "{h2}" },
    "footer": { "center": "{page} / {pages}" }
  },

  // ---------------------------------------------------------------- Page HTML
  "layout": {
    "sidebarWidth": 320,         // largeur initiale du sommaire en px (glisser sa bordure pour ajuster)
    "contentWidthPercent": 90    // part de la largeur restante occupée par le contenu
  },

  "style": {
    // COULEURS DE LA PAGE : palette utilisée quand le mode de page est clair / sombre.
    // Valeurs intégrées : "default", "formal" (clair) et "neon" (sombre).
    "pageTheme": { "light": "default", "dark": "default" },
    // Pour créer une palette à vous, ajoutez un nom et les couleurs à changer (détails dans README.md §5.7).
    // Clés disponibles : bg, fg, muted, border, sidebarBg, accent, codeBg, quote.
    "pagePalettes": {},

    // MODE DU CODE : "follow" suit le mode actuel de la page (conseillé).
    // "auto" suit directement le thème clair/sombre du système, sans suivre le bouton de la page.
    // "light" ou "dark" imposent toujours ce mode aux balises de code.
    "codeTheme": { "mode": "follow" },
    // COULEURS DU CODE : thème de coloration syntaxique choisi pour chaque mode du code.
    // "default" = thèmes intégrés du générateur ; un nom connu (ex. "vs", "vs2015", "github-dark")
    // = thème highlight.js ; un fichier .css dans template/ ou doc/ = thème personnalisé.
    "highlight": { "light": "default", "dark": "highlight-neon.css" },

    // Thème des diagrammes Mermaid : "auto", default, dark, forest ou neutral
    "mermaidTheme": "auto",
    // layout : "dagre" (hiérarchique) ou "elk" (adaptatif) ; direction : null, "TB", "BT", "LR" ou "RL".
    // Modifiable par diagramme dans le .md : ```mermaid layout=elk direction=LR
    "mermaid": { "layout": "elk", "direction": "TB" },
    // Taille / retrait / couleur de chaque niveau de titre (« headings ») et du sommaire (« toc ») : voir README.md
    "customCss": null            // fichier CSS supplémentaire (relatif à doc/), appliqué en dernier
  }
}
